---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you requested does not exist." noindex={true}>
  <div class="mx-auto max-w-xl px-6 py-24 text-center">
    <p class="font-mono text-6xl font-bold text-emerald-600 dark:text-emerald-400">404</p>
    <h1 class="mt-4 text-2xl font-semibold">Page not found</h1>
    <p class="mt-4 text-slate-600 dark:text-slate-400">
      That URL may be from the old static site. Try the homepage or blog.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href="/" class="btn-primary">Home</a>
      <a href="/blog" class="btn-secondary">Blog</a>
    </div>
  </div>
</BaseLayout>
