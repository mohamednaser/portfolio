---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';

const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Hello from mnaser.me')}`;
---

<BaseLayout
  title="Contact"
  description="Get in touch with Mohamed Naser for technical leadership and AI adoption consulting."
>
  <div class="mx-auto max-w-2xl px-6 py-16 text-center">
    <h1 class="section-heading">Contact</h1>
    <p class="mt-6 text-lg text-slate-600 dark:text-slate-300">
      Hiring, consulting, or collaboration — the fastest route is email.
    </p>
    <a href={mailto} class="btn-primary mt-10">
      Email {site.email}
    </a>
    <ul class="mt-12 flex flex-wrap justify-center gap-6 text-sm">
      <li>
        <a href={site.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-emerald-600 hover:underline dark:text-emerald-400">
          LinkedIn
        </a>
      </li>
      <li>
        <a href={site.social.github} target="_blank" rel="noopener noreferrer" class="text-emerald-600 hover:underline dark:text-emerald-400">
          GitHub
        </a>
      </li>
    </ul>
    <p class="mt-12 text-sm text-slate-500 dark:text-slate-500">
      The legacy PHP contact form has been removed. No data is collected on this page.
    </p>
  </div>
</BaseLayout>
