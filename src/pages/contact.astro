---
import SocialLinks from '../components/SocialLinks.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';

const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Hello from mnaser.me')}`;
---

<BaseLayout
  title="Contact"
  description="Get in touch with Mohamed Naser — email, LinkedIn, GitHub, Stack Overflow, X, Medium, and HackerRank."
>
  <div class="mx-auto max-w-2xl px-6 py-16 text-center">
    <h1 class="section-heading">Contact</h1>
    <p class="mt-6 text-lg text-slate-600 dark:text-slate-300">
      Hiring, consulting, or collaboration — the fastest route is email.
    </p>
    <p class="mt-2 text-sm text-slate-500 dark:text-slate-500">{site.location}</p>

    <a href={mailto} class="btn-primary mt-10">
      Email {site.email}
    </a>

    <section class="mt-14" aria-labelledby="social-heading">
      <h2 id="social-heading" class="text-lg font-semibold text-slate-900 dark:text-slate-50">
        Connect
      </h2>
      <SocialLinks showLabels class="mt-6 justify-center" />
    </section>
  </div>
</BaseLayout>
