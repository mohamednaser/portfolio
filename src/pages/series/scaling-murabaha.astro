---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contentSlug } from '../../lib/slug';
import { getCollection } from 'astro:content';

const ORDER = [
  'commodity-murabaha-platform',
  'scaling-murabaha-10-to-5000-orders',
  'scaling-queue-workers-3-to-122',
];

const posts = await getCollection('blog', ({ data }) => !data.draft);
const parts = ORDER.map((slug) => posts.find((p) => contentSlug(p.id) === slug)).filter(
  (p): p is NonNullable<typeof p> => Boolean(p)
);

const title = 'Scaling a Commodity Murabaha Platform';
const description =
  'A three-part engineering series on taking a Sharia-compliant Murabaha platform from ten orders to five thousand: the process, the database battles, and the worker fleet.';
---

<BaseLayout
  title={title}
  seoTitle={title}
  description={description}
  image="/images/blog/scaling-murabaha-10-to-5000-orders/cover.jpg"
  keywords={[
    'commodity murabaha',
    'scaling fintech',
    'database performance',
    'queue workers',
    'islamic finance technology',
  ]}
>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <p class="font-mono text-xs uppercase tracking-widest text-emerald-600 dark:text-emerald-400">
      Series · 3 parts
    </p>
    <h1
      class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50 sm:text-4xl"
    >
      {title}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-400">
      In January 2025 a stress test of ten automated orders left four of them stuck. Eighteen months
      later the same platform ran 5,200 orders end to end at 99.94%, and 5,000-order runs became a
      daily routine. This is what happened in between — fifteen case files, the failed attempts
      included.
    </p>

    <ol class="mt-12 space-y-6">
      {
        parts.map((post, i) => (
          <li>
            <a
              href={`/blog/${contentSlug(post.id)}/`}
              class="group flex flex-col gap-5 rounded-xl border border-slate-200 p-5 transition hover:border-emerald-500 dark:border-slate-800 dark:hover:border-emerald-500 sm:flex-row"
            >
              {post.data.coverImage && (
                <img
                  src={post.data.coverImage}
                  alt=""
                  width={200}
                  height={105}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[1200/630] w-full shrink-0 self-start rounded-lg object-cover sm:w-48"
                />
              )}
              <div>
                <p class="font-mono text-xs uppercase tracking-widest text-slate-500">
                  Part {i + 1}
                  {post.data.readingTime && <span class="ml-2">· {post.data.readingTime}</span>}
                </p>
                <h2 class="mt-2 text-lg font-semibold text-slate-900 group-hover:text-emerald-600 dark:text-slate-100 dark:group-hover:text-emerald-400">
                  {post.data.title}
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                  {post.data.description}
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ol>

    <p class="mt-12">
      <a
        href="/blog"
        class="text-sm font-medium text-emerald-600 hover:underline dark:text-emerald-400"
      >
        ← Blog
      </a>
    </p>
  </div>
</BaseLayout>
