---
import BlogPostCard from '../../components/BlogPostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const blogKeywords = [
  'AI agents',
  'LLM testing',
  'technical leadership',
  'software engineering',
  'Mohamed Naser',
];
---

<BaseLayout
  title="Blog"
  description="Articles on AI agents, LLM evaluation, engineering leadership, and shipping reliable software — with links to read on Medium and LinkedIn."
  keywords={blogKeywords}
>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <header>
      <h1 class="section-heading">Blog</h1>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">
        Writing on AI-augmented engineering, agent quality, and technical leadership. Summaries
        and SEO live here; full articles on Medium.
      </p>
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-500">
        <a href="/rss.xml" class="text-emerald-600 hover:underline dark:text-emerald-400">RSS feed</a>
      </p>
    </header>

    {
      posts.length === 0 ? (
        <p class="mt-12 text-slate-600 dark:text-slate-400">No posts yet.</p>
      ) : (
        <div class="mt-10">
          {posts.map((post) => (
            <BlogPostCard key={post.id} post={post} />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
