---
import BlogReadLinks from '../../components/BlogReadLinks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../site.config';
import { contentSlug } from '../../lib/slug';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: contentSlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const isExternal = post.data.external;
const teaser = post.data.excerpt ?? post.data.description;
const cover = post.data.coverImage ?? site.image;
const publishedTime = post.data.pubDate.toISOString();
const modifiedTime = (post.data.updatedDate ?? post.data.pubDate).toISOString();
---

<BaseLayout
  title={post.data.title}
  seoTitle={post.data.title}
  description={post.data.description}
  image={cover}
  type="article"
  keywords={post.data.keywords}
  alternateUrl={post.data.mediumUrl}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
>
  <article class="mx-auto max-w-3xl px-6 py-16">
    <header>
      <time datetime={publishedTime} class="text-sm text-slate-500">
        {post.data.pubDate.toLocaleDateString('en-GB', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        })}
        {post.data.readingTime && (
          <span class="before:mx-2 before:content-['·']">{post.data.readingTime}</span>
        )}
      </time>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50 sm:text-4xl">
        {post.data.title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-400">
        {teaser}
      </p>

      {
        post.data.coverImage && (
          <img
            src={post.data.coverImage}
            alt={post.data.title}
            width={800}
            height={533}
            class="mt-8 aspect-[3/2] w-full rounded-xl object-cover"
            loading="eager"
          />
        )
      }

      <BlogReadLinks
        mediumUrl={post.data.mediumUrl}
        linkedinUrl={post.data.linkedinUrl}
        class="mt-8"
      />

      {
        post.data.keywords.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-2" aria-label="Keywords">
            {post.data.keywords.map((keyword) => (
              <li>
                <span class="rounded-full bg-emerald-50 px-3 py-1 text-sm text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                  {keyword}
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      !isExternal && (
        <div class="mt-10 space-y-4 leading-relaxed text-slate-700 dark:text-slate-300 [&_a]:text-emerald-600 [&_a]:underline dark:[&_a]:text-emerald-400">
          <Content />
        </div>
      )
    }

    {
      isExternal && post.data.mediumUrl && (
        <div class="mt-10 rounded-xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900/50">
          <p class="text-slate-700 dark:text-slate-300">
            The full article is on{' '}
            <a
              href={post.data.mediumUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-emerald-600 underline dark:text-emerald-400"
            >
              Medium
            </a>
            . Use the button above for the complete piece, comments, and sharing.
          </p>
        </div>
      )
    }

    <p class="mt-12">
      <a href="/blog" class="text-sm font-medium text-emerald-600 hover:underline dark:text-emerald-400">
        ← Blog
      </a>
    </p>
  </article>
</BaseLayout>
