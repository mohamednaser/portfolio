---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---

<BaseLayout title="Projects" description="Open source and product work — ApexYard, Blog Generator, and portfolio.">
  <div class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="section-heading">Projects</h1>
    <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-400">
      Repositories and products I build or govern under ApexYard.
    </p>
    <ul class="mt-12 grid gap-6 md:grid-cols-2">
      {
        projects.map((p) => (
          <li class="card">
            <h2 class="text-xl font-semibold">
              <a href={p.href} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-600 dark:hover:text-emerald-400">
                {p.name} ↗
              </a>
            </h2>
            <p class="mt-3 text-slate-600 dark:text-slate-400">{p.description}</p>
            <ul class="mt-4 flex flex-wrap gap-2">
              {p.tags.map((tag) => (
                <li class="rounded-full bg-emerald-50 px-2 py-0.5 text-xs text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                  {tag}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
