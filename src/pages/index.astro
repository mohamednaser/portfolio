---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mohamed Naser — Coming soon">
  <main class="mx-auto flex min-h-screen max-w-2xl flex-col justify-center px-6 py-16">
    <p class="font-mono text-sm uppercase tracking-widest text-emerald-400">
      Portfolio refactor in progress
    </p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">
      Technical lead empowering teams with AI
    </h1>
    <p class="mt-6 text-lg leading-relaxed text-slate-300">
      mnaser.me is being rebuilt on Astro + Tailwind. The full site — case studies,
      testimonials, blog, and contact — ships in upcoming PRs.
    </p>
    <p class="mt-10 text-sm text-slate-500">
      Built with Astro {Astro.generator} · Tailwind CSS
    </p>
  </main>
</BaseLayout>
