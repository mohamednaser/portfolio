---
import CompanyLogos from '../components/CompanyLogos.astro';
import TestimonialsMarquee from '../components/TestimonialsMarquee.astro';
import { testimonials } from '../data/testimonials';
import ProjectCard from '../components/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
import { isPublishedProject } from '../lib/projects';
import { contentSlug } from '../lib/slug';
import { getCollection } from 'astro:content';

/** Homepage “Selected projects” — fixed trio; not driven by `featured` alone. */
const homepageProjectSlugs = ['lynk', 'carefer', 'ynmo'] as const;

const featuredProjects = (await getCollection('projects'))
  .filter(isPublishedProject)
  .filter((project) =>
    homepageProjectSlugs.includes(contentSlug(project.id) as (typeof homepageProjectSlugs)[number]),
  )
  .sort(
    (a, b) =>
      homepageProjectSlugs.indexOf(contentSlug(a.id) as (typeof homepageProjectSlugs)[number]) -
      homepageProjectSlugs.indexOf(contentSlug(b.id) as (typeof homepageProjectSlugs)[number]),
  );
---

<BaseLayout>
  <section class="mx-auto max-w-5xl px-6 py-16 sm:py-24">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_280px]">
      <div>
        <p class="font-mono text-sm uppercase tracking-widest text-emerald-600 dark:text-emerald-400">
          Problem solver · Experienced developer · AI for teams &amp; products
        </p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-slate-900 dark:text-slate-50 sm:text-5xl">
          I solve hard problems across domains — then help teams ship smarter with AI
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
          10+ years across fintech, mobility, e-commerce, government, and education: untangling
          complexity, building systems that scale, and leading delivery from <strong>Lynk</strong> to{' '}
          <strong>Carefer</strong>. Today I focus on empowering teams and products with
          AI-augmented engineering — and I write about that on{' '}
          <a
            href={site.social.medium}
            target="_blank"
            rel="noopener noreferrer"
            class="font-medium text-emerald-600 underline decoration-emerald-600/30 underline-offset-2 hover:decoration-emerald-600 dark:text-emerald-400 dark:decoration-emerald-400/30"
          >
            Medium
          </a>
          .
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="/projects" class="btn-primary">View projects</a>
          <a href="/blog" class="btn-secondary">Blog</a>
          <a href="/contact" class="btn-secondary">Get in touch</a>
        </div>
      </div>
      <img
        src={site.image}
        alt="Mohamed Naser"
        width="280"
        height="280"
        class="mx-auto rounded-2xl object-cover shadow-lg lg:mx-0"
        loading="eager"
      />
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 py-16">
    <h2 class="section-heading">Selected projects</h2>
    <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-400">
      Stack, achievements, and write-ups for each product I ship or govern.
    </p>
    <ul class="mt-10 grid gap-6 md:grid-cols-3">
      {featuredProjects.map((project) => <ProjectCard project={project} compact />)}
    </ul>
    <p class="mt-8">
      <a href="/projects" class="text-sm font-medium text-emerald-600 hover:underline dark:text-emerald-400">
        View all projects →
      </a>
    </p>
  </section>

  <CompanyLogos />

  <section class="border-t border-slate-200 bg-slate-50 py-16 dark:border-slate-800 dark:bg-slate-900/40">
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="section-heading">What collaborators say</h2>
      <TestimonialsMarquee items={testimonials} />
      <p class="mt-8 text-center">
        <a href="/about#testimonials" class="text-sm font-medium text-emerald-600 hover:underline dark:text-emerald-400">
          Read all {testimonials.length} testimonials →
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
