---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contentSlug } from '../../lib/slug';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const studies = await getCollection('case-studies');
  return studies.map((study) => ({
    params: { slug: contentSlug(study.id) },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);
---

<BaseLayout title={study.data.title} description={study.data.description} type="article">
  <article class="mx-auto max-w-3xl px-6 py-16">
    <p class="text-sm text-emerald-600 dark:text-emerald-400">{study.data.context}</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight text-slate-900 dark:text-slate-50">
      {study.data.title}
    </h1>
    <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">{study.data.description}</p>
    <div class="mt-10 space-y-4 leading-relaxed text-slate-700 dark:text-slate-300 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-semibold [&_strong]:text-slate-900 dark:[&_strong]:text-slate-100">
      <Content />
    </div>
    <p class="mt-12">
      <a href="/ai" class="text-sm font-medium text-emerald-600 hover:underline dark:text-emerald-400">
        ← All case studies
      </a>
    </p>
  </article>
</BaseLayout>
