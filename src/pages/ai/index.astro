---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contentSlug } from '../../lib/slug';
import { getCollection } from 'astro:content';

const studies = (await getCollection('case-studies')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="How I empower teams with AI"
  description="Case studies on ApexYard, Claude Code adoption, and AI-augmented SDLC for engineering teams."
>
  <div class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="section-heading">How I empower teams with AI</h1>
    <p class="mt-6 max-w-2xl text-lg text-slate-600 dark:text-slate-300">
      Concrete rollouts — what was shipped, how agents and hooks were introduced, and what
      we learned. Not generic “AI strategy” slides.
    </p>
    <ul class="mt-12 space-y-8">
      {
        studies.map((study) => (
          <li>
            <article class="card">
              <p class="text-xs font-medium uppercase tracking-wide text-emerald-600 dark:text-emerald-400">
                {study.data.context}
              </p>
              <h2 class="mt-2 text-2xl font-semibold">
                <a href={`/ai/${contentSlug(study.id)}`} class="hover:text-emerald-600 dark:hover:text-emerald-400">
                  {study.data.title}
                </a>
              </h2>
              <p class="mt-3 text-slate-600 dark:text-slate-400">{study.data.description}</p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {study.data.tags.map((tag) => (
                  <li class="rounded-full bg-slate-100 px-2 py-0.5 text-xs dark:bg-slate-800">{tag}</li>
                ))}
              </ul>
              <a
                href={`/ai/${contentSlug(study.id)}`}
                class="mt-6 inline-block text-sm font-medium text-emerald-600 hover:underline dark:text-emerald-400"
              >
                Read case study →
              </a>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>
