        <rect x="102" y="58" width="36" height="46" rx="3" fill="var(--card)" stroke="currentColor" stroke-opacity="0.6"></rect>
        <path d="M126,58 l12,12 l-12,0 z" fill="currentColor" opacity="0.25"></path>
