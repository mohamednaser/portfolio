---
import type { Testimonial } from '../data/testimonials';

interface Props {
  item: Testimonial;
}

const { item } = Astro.props;
---

<figure class="card flex h-full flex-col">
  <blockquote class="flex-1 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
    <p>&ldquo;{item.quote}&rdquo;</p>
  </blockquote>
  <figcaption class="mt-6 flex items-center gap-4">
    <img
      src={item.image}
      alt=""
      width="48"
      height="48"
      class="h-12 w-12 rounded-full object-cover"
      loading="lazy"
    />
    <div>
      <cite class="not-italic font-semibold text-slate-900 dark:text-slate-50">
        {item.name}
      </cite>
      {item.context && (
        <p class="text-xs text-slate-500 dark:text-slate-400">{item.context}</p>
      )}
    </div>
  </figcaption>
</figure>
