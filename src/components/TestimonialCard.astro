---
import type { Testimonial } from '../data/testimonials';
import { defaultLang, type Lang } from '../i18n';
import { fill, useTranslations } from '../i18n/ui';
import { site } from '../site.config';

interface Props {
  item: Testimonial;
  lang?: Lang;
}

const { item, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const linkedinHref = site.social.linkedinRecommendations;
const linkedinLabel = fill(t.testimonials.linkedinLabel, { name: item.name });
---

<figure class="card relative flex h-full flex-col">
  <a
    href={linkedinHref}
    target="_blank"
    rel="noopener noreferrer"
    class="absolute end-4 top-4 text-[#0A66C2] transition hover:text-[#004182] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0A66C2] dark:text-[#70B5F9] dark:hover:text-[#9CCCFC]"
    aria-label={linkedinLabel}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="currentColor"
      class="h-5 w-5"
      aria-hidden="true"
    >
      <path
        d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
      ></path>
    </svg>
  </a>
  <blockquote class="flex-1 pe-8 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
    <p>&ldquo;{item.quote}&rdquo;</p>
  </blockquote>
  <figcaption class="mt-6 flex items-center gap-4">
    <img
      src={item.image}
      alt=""
      width="48"
      height="48"
      class="h-12 w-12 rounded-full object-cover"
      loading="lazy"
    />
    <div>
      <cite class="not-italic font-semibold text-slate-900 dark:text-slate-50">
        {item.name}
      </cite>
      {item.context && <p class="text-xs text-slate-500 dark:text-slate-400">{item.context}</p>}
    </div>
  </figcaption>
</figure>
