---
import ProjectCard from '../ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import { getProjects, projectSlug } from '../../lib/projects';
import { site } from '../../site.config';
import { localizePath } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const allProjects = await getProjects(lang);

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: allProjects.map((project, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(localizePath(`/projects/${projectSlug(project)}`, lang), site.url).href,
  })),
};
---

<BaseLayout lang={lang} title={t.projects.title} description={t.projects.metaDescription}>
  <div class="fade-up mx-auto max-w-5xl px-6 py-16">
    <h1 class="section-heading">{t.projects.title}</h1>
    <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-400">
      {t.projects.intro}
    </p>
    <ul class="mt-12 grid gap-6 md:grid-cols-2">
      {allProjects.map((project) => <ProjectCard project={project} lang={lang} />)}
    </ul>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
</BaseLayout>
