---
import ProjectCard from '../ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import { getProjects } from '../../lib/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const allProjects = await getProjects(lang);
---

<BaseLayout lang={lang} title={t.projects.title} description={t.projects.metaDescription}>
  <div class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="section-heading">{t.projects.title}</h1>
    <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-400">
      {t.projects.intro}
    </p>
    <ul class="mt-12 grid gap-6 md:grid-cols-2">
      {allProjects.map((project) => <ProjectCard project={project} lang={lang} />)}
    </ul>
  </div>
</BaseLayout>
