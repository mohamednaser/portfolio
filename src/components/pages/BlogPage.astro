---
import BlogPostCard from '../BlogPostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultLang, localizePath, type Lang } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import { getBlogPosts, blogPath } from '../../lib/blog';
import { site } from '../../site.config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = await getBlogPosts(lang);
const feed = localizePath('/rss.xml', lang);
const seriesHref = localizePath('/series/scaling-murabaha', lang);

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: posts.map((post, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: new URL(blogPath(post, lang), site.url).href,
  })),
};
---

<BaseLayout
  lang={lang}
  title={t.blog.title}
  description={t.blog.metaDescription}
  keywords={t.blog.keywords}
>
  <div class="fade-up mx-auto max-w-3xl px-6 py-16">
    <header>
      <h1 class="section-heading">{t.blog.title}</h1>
      <p class="mt-4 text-lg text-slate-600 dark:text-slate-400">
        {t.blog.intro}
      </p>
      {
        t.blog.languageNote && (
          <p class="mt-4 rounded-lg bg-slate-50 px-4 py-3 text-sm text-slate-600 dark:bg-slate-900 dark:text-slate-400">
            {t.blog.languageNote}
          </p>
        )
      }
      <p class="mt-2 text-sm text-slate-500 dark:text-slate-500">
        <a
          href={feed}
          class="text-emerald-700 hover:underline dark:text-emerald-400"
        >
          {t.blog.rss}
        </a>
      </p>
    </header>

    <a
      href={seriesHref}
      class="group mt-10 block rounded-xl border border-slate-200 p-5 transition hover:border-emerald-500 dark:border-slate-800 dark:hover:border-emerald-500"
    >
      <p
        class:list={[
          'text-xs text-emerald-700 dark:text-emerald-400',
          // Matches the hero eyebrow: no Latin tracking on cursive Arabic.
          lang === defaultLang ? 'font-mono uppercase tracking-widest' : 'font-medium',
        ]}
      >
        {t.blog.seriesEyebrow}
      </p>
      <p
        class="mt-2 font-semibold text-slate-900 group-hover:text-emerald-700 dark:text-slate-100 dark:group-hover:text-emerald-400"
      >
        {t.series.title}
      </p>
      <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
        {t.blog.seriesBlurb}
      </p>
      <p class="mt-3 text-sm font-medium text-emerald-700 dark:text-emerald-400">
        {t.blog.seriesCta}
      </p>
    </a>

    {
      posts.length === 0 ? (
        <p class="mt-12 text-slate-600 dark:text-slate-400">{t.blog.empty}</p>
      ) : (
        <div class="mt-10">
          {posts.map((post) => (
            <BlogPostCard post={post} lang={lang} />
          ))}
        </div>
      )
    }
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
</BaseLayout>
