---
import CompanyLogos from '../CompanyLogos.astro';
import ProjectCard from '../ProjectCard.astro';
import TestimonialsMarquee from '../TestimonialsMarquee.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPillars, getStats, getTestimonials } from '../../data/i18n';
import { defaultLang, localizePath, type Lang } from '../../i18n';
import { fill, useTranslations } from '../../i18n/ui';
import { getProjects, projectSlug } from '../../lib/projects';
import { Image } from 'astro:assets';
import { site } from '../../site.config';
import mohamedImg from '@/assets/images/mohamed.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const testimonials = getTestimonials(lang);
const stats = getStats(lang);
const pillars = getPillars(lang);

/** Homepage “Selected projects” — fixed trio; not driven by `featured` alone. */
const homepageProjectSlugs = ['lynk', 'carefer', 'ynmo'];

const featuredProjects = (await getProjects(lang))
  .filter((project) => homepageProjectSlugs.includes(projectSlug(project)))
  .sort(
    (a, b) =>
      homepageProjectSlugs.indexOf(projectSlug(a)) - homepageProjectSlugs.indexOf(projectSlug(b)),
  );

const mediumLink = `<a href="${site.social.medium}" target="_blank" rel="noopener noreferrer" class="font-medium text-emerald-700 underline decoration-emerald-700/30 underline-offset-2 hover:decoration-emerald-700 dark:text-emerald-400 dark:decoration-emerald-400/30">Medium</a>`;
const introHtml = fill(t.home.introHtml, { medium: mediumLink });
---

<BaseLayout lang={lang}>
  <div class="relative overflow-hidden">
    <div class="hero-mesh"></div>
    <!-- No `fade-up` here: the hero is the LCP element, and gating it on the
         scroll-reveal script delays first paint of the page's main content. -->
    <section class="relative z-10 mx-auto max-w-5xl px-6 py-16 sm:py-24">
      <div class="grid items-center gap-12 lg:grid-cols-[1fr_280px]">
        <div>
          <p
            class:list={[
              'text-sm text-emerald-700 dark:text-emerald-400',
              // Arabic is cursive: letter-spacing severs the joins between letters,
              // and the mono stack has no Arabic face to fall back on.
              lang === defaultLang ? 'font-mono uppercase tracking-widest' : 'font-medium',
            ]}
          >
            {t.home.eyebrow}
          </p>
          <h1
            class="mt-4 text-4xl font-semibold tracking-tight text-slate-900 dark:text-slate-50 sm:text-5xl"
          >
            {t.home.headline}
          </h1>
          <p
            class="mt-6 max-w-xl text-lg leading-relaxed text-slate-600 dark:text-slate-300"
            set:html={introHtml}
          />
          <div class="mt-10 flex flex-wrap gap-4">
            <a href={localizePath('/projects', lang)} class="btn-primary">{t.home.ctaProjects}</a>
            <a href={localizePath('/blog', lang)} class="btn-secondary">{t.home.ctaBlog}</a>
            <a href={localizePath('/contact', lang)} class="btn-secondary">{t.home.ctaContact}</a>
          </div>
        </div>
        <Image
          src={mohamedImg}
          alt={t.home.portraitAlt}
          width={280}
          height={280}
          class="mx-auto rounded-2xl object-cover shadow-lg lg:mx-0"
          loading="eager"
        />
      </div>

      <!-- `flex-col-reverse` keeps the pair in `dt` → `dd` document order while
         showing the figure above its label. -->
      <dl
        aria-label={t.home.statsLabel}
        class="mt-14 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-slate-200 bg-slate-200 dark:border-slate-800 dark:bg-slate-800 sm:grid-cols-4"
      >
        {
          stats.map((stat) => (
            <div class="flex flex-col-reverse bg-white p-5 text-center dark:bg-slate-950">
              <dt class="mt-2 text-xs leading-snug text-slate-600 dark:text-slate-400">
                {stat.label}
              </dt>
              <dd class="text-2xl font-semibold tracking-tight text-emerald-700 dark:text-emerald-400 sm:text-3xl">
                {stat.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>

  <section class="fade-up mx-auto max-w-5xl px-6 py-16">
    <h2 class="section-heading">{t.home.howIHelp}</h2>
    <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-400">
      {t.home.howIHelpIntro}
    </p>
    <ul class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        pillars.map((pillar) => (
          <li class="card">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-50">{pillar.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
              {pillar.description}
            </p>
          </li>
        ))
      }
    </ul>
    <p class="mt-8">
      <a
        href={localizePath('/services', lang)}
        class="text-sm font-medium text-emerald-700 hover:underline dark:text-emerald-400"
      >
        {t.home.howIHelpCta}
      </a>
    </p>
  </section>

  <section class="fade-up mx-auto max-w-5xl px-6 py-16">
    <h2 class="section-heading">{t.home.selectedProjects}</h2>
    <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-400">
      {t.home.selectedProjectsIntro}
    </p>
    <ul class="mt-10 grid gap-6 md:grid-cols-3">
      {featuredProjects.map((project) => <ProjectCard project={project} lang={lang} compact />)}
    </ul>
    <p class="mt-8">
      <a
        href={localizePath('/projects', lang)}
        class="text-sm font-medium text-emerald-700 hover:underline dark:text-emerald-400"
      >
        {t.home.allProjects}
      </a>
    </p>
  </section>

  <CompanyLogos lang={lang} />

  <section
    class="fade-up border-t border-slate-200 bg-slate-50 py-16 dark:border-slate-800 dark:bg-slate-900/40"
  >
    <div class="mx-auto max-w-5xl px-6">
      <h2 class="section-heading">{t.home.testimonialsHeading}</h2>
      <TestimonialsMarquee items={testimonials} lang={lang} />
      <p class="mt-8 text-center">
        <a
          href={`${localizePath('/about', lang)}#testimonials`}
          class="text-sm font-medium text-emerald-700 hover:underline dark:text-emerald-400"
        >
          {fill(t.home.allTestimonials, { count: testimonials.length })}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
