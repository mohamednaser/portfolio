---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localizePath, type Lang } from '../../i18n';
import { fill, useTranslations } from '../../i18n/ui';
import { blogLang, blogPath, blogSlug, getBlogPosts } from '../../lib/blog';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const ORDER = [
  'murabaha-as-a-state-machine',
  'mysql-under-load-sharia-compliant-pipeline',
  'laravel-queue-workers-regulated-trade-pipeline',
];

const posts = await getBlogPosts(lang);
const parts = ORDER.map((slug) =>
  posts.find((post) => blogSlug(post) === slug),
).filter((post): post is NonNullable<typeof post> => Boolean(post));
---

<BaseLayout
  lang={lang}
  title={t.series.title}
  seoTitle={t.series.title}
  description={t.series.metaDescription}
  image="/images/blog/mysql-under-load-sharia-compliant-pipeline/cover.jpg"
  keywords={t.series.keywords}
>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <p
      class="font-mono text-xs uppercase tracking-widest text-emerald-600 dark:text-emerald-400"
    >
      {t.series.eyebrow}
    </p>
    <h1
      class="mt-3 text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50 sm:text-4xl"
    >
      {t.series.title}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-400">
      {t.series.intro}
    </p>

    <ol class="mt-12 space-y-6">
      {
        parts.map((post, i) => (
          <li>
            <a
              href={blogPath(post, lang)}
              class="group flex flex-col gap-5 rounded-xl border border-slate-200 p-5 transition hover:border-emerald-500 dark:border-slate-800 dark:hover:border-emerald-500 sm:flex-row"
            >
              {post.data.coverImage && (
                <img
                  src={post.data.coverImage}
                  alt=""
                  width={200}
                  height={105}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[1200/630] w-full shrink-0 self-start rounded-lg object-cover sm:w-48"
                />
              )}
              <div
                lang={blogLang(post) !== lang ? 'en' : undefined}
                dir={blogLang(post) !== lang ? 'ltr' : undefined}
              >
                <p class="font-mono text-xs uppercase tracking-widest text-slate-500">
                  {fill(t.series.part, { n: i + 1 })}
                  {post.data.readingTime && (
                    <span class="ms-2">· {post.data.readingTime}</span>
                  )}
                </p>
                <h2 class="mt-2 text-lg font-semibold text-slate-900 group-hover:text-emerald-600 dark:text-slate-100 dark:group-hover:text-emerald-400">
                  {post.data.title}
                </h2>
                <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
                  {post.data.description}
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ol>

    <p class="mt-12">
      <a
        href={localizePath('/blog', lang)}
        class="text-sm font-medium text-emerald-600 hover:underline dark:text-emerald-400"
      >
        {t.series.back}
      </a>
    </p>
  </div>
</BaseLayout>
