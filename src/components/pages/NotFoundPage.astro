---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, localizePath, type Lang } from '../../i18n';
import { useTranslations } from '../../i18n/ui';

interface Props {
  lang: Lang;
  /**
   * GitHub Pages serves a single `/404.html` for every missing path, whatever
   * the locale — so the root 404 repeats itself in the other language rather
   * than shipping an `/ar/404` that can never be reached.
   */
  alsoShow?: Lang;
}

const { lang, alsoShow } = Astro.props;
const t = useTranslations(lang);
const alt = alsoShow ? useTranslations(alsoShow) : null;
---

<BaseLayout
  lang={lang}
  title={t.notFound.title}
  description={t.notFound.metaDescription}
  noindex={true}
>
  <div class="mx-auto max-w-xl px-6 py-24 text-center">
    <p class="font-mono text-6xl font-bold text-emerald-600 dark:text-emerald-400">404</p>
    <h1 class="mt-4 text-2xl font-semibold">{t.notFound.title}</h1>
    <p class="mt-4 text-slate-600 dark:text-slate-400">{t.notFound.body}</p>
    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a href={localizePath('/', lang)} class="btn-primary">{t.notFound.home}</a>
      <a href="/blog" class="btn-secondary" hreflang="en">{t.notFound.blog}</a>
    </div>

    {
      alsoShow && alt && (
        <div
          lang={languages[alsoShow].htmlLang}
          dir={languages[alsoShow].dir}
          class="mt-12 border-t border-slate-200 pt-10 dark:border-slate-800"
        >
          <h2 class="text-xl font-semibold">{alt.notFound.title}</h2>
          <p class="mt-3 text-slate-600 dark:text-slate-400">{alt.notFound.body}</p>
          <p class="mt-6">
            <a href={localizePath('/', alsoShow)} class="btn-secondary">
              {alt.notFound.home}
            </a>
          </p>
        </div>
      )
    }
  </div>
</BaseLayout>
