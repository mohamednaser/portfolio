---
import BlogReadLinks from '../BlogReadLinks.astro';
import PostToc from '../PostToc.astro';
import SeriesNav from '../SeriesNav.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { defaultLang, localizePath, type Lang } from '../../i18n';
import { fill, useTranslations } from '../../i18n/ui';
import { blogLang, blogSlug, type BlogEntry } from '../../lib/blog';
import { getSeriesPosition } from '../../lib/series';
import { site, siteMeta } from '../../site.config';
import { render } from 'astro:content';

interface Props {
  post: BlogEntry;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const meta = siteMeta[lang];
const { Content } = await render(post);

/** A post with no entry for `lang` falls back to English — isolate its body. */
const bodyLang = blogLang(post);
const isFallback = bodyLang !== lang;
const isTranslation = !isFallback && lang !== defaultLang;

const isExternal = post.data.external;
const teaser = post.data.excerpt ?? post.data.description;
const cover = post.data.coverImage ?? site.image;
const publishedTime = post.data.pubDate.toISOString();
const modifiedTime = (post.data.updatedDate ?? post.data.pubDate).toISOString();
const formattedDate = post.data.pubDate.toLocaleDateString(t.post.dateLocale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const mediumAnchor = `<a href="${site.social.medium}" target="_blank" rel="noopener noreferrer" class="font-medium text-emerald-700 underline dark:text-emerald-400">Medium</a>`;
const externalHtml = fill(t.post.externalHtml, { medium: mediumAnchor });
const originalHref = `/blog/${blogSlug(post)}/`;

/** Only the Murabaha parts get prev/next; everything else gets `null`. */
const seriesPosition = isExternal ? null : await getSeriesPosition(post, lang);
---

<BaseLayout
  lang={lang}
  title={post.data.searchTitle ?? post.data.title}
  seoTitle={post.data.title}
  description={post.data.description}
  image={cover}
  type="article"
  keywords={post.data.keywords}
  alternateUrl={post.data.mediumUrl}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
>
  <article class="mx-auto max-w-5xl px-6 py-16 lg:grid lg:grid-cols-[1fr_240px] lg:items-start lg:gap-12">
    <div class="min-w-0 max-w-3xl w-full">
    <header>
      <time datetime={publishedTime} class="text-sm text-slate-500">
        {formattedDate}
        {
          post.data.readingTime && (
            <span class="before:mx-2 before:content-['·']">
              {post.data.readingTime}
            </span>
          )
        }
      </time>
      <h1
        class="mt-2 text-3xl font-bold tracking-tight text-slate-900 dark:text-slate-50 sm:text-4xl"
        lang={isFallback ? 'en' : undefined}
        dir={isFallback ? 'ltr' : undefined}
      >
        {post.data.title}
      </h1>
      <p class="mt-3 text-sm text-slate-600 dark:text-slate-400">
        {t.post.by}
        <span class="font-medium text-slate-900 dark:text-slate-100"
          >{meta.name}</span
        >
        <span class="before:mx-2 before:content-['·']">{t.post.authorRole}</span
        >
      </p>
      <p
        class="mt-4 text-lg leading-relaxed text-slate-600 dark:text-slate-400"
        lang={isFallback ? 'en' : undefined}
        dir={isFallback ? 'ltr' : undefined}
      >
        {teaser}
      </p>

      {
        isTranslation && (
          <p class="mt-4 rounded-lg bg-slate-50 px-4 py-3 text-sm text-slate-600 dark:bg-slate-900 dark:text-slate-400">
            {t.post.translationNote}
            <a
              href={originalHref}
              hreflang="en"
              class="ms-1 font-medium text-emerald-700 hover:underline dark:text-emerald-400"
            >
              {t.post.readOriginal}
            </a>
          </p>
        )
      }

      {
        post.data.coverImage && (
          <img
            src={post.data.coverImage}
            alt={post.data.title}
            width={800}
            height={420}
            class="mt-8 aspect-[1200/630] w-full rounded-xl object-cover"
            loading="eager"
          />
        )
      }

      <BlogReadLinks
        mediumUrl={post.data.mediumUrl}
        linkedinUrl={post.data.linkedinUrl}
        class="mt-8"
      />

      {
        post.data.tags.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-2" aria-label={t.post.topics}>
            {post.data.tags.map((tag) => (
              <li>
                <span class="rounded-full bg-emerald-50 px-3 py-1 text-sm text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
                  {tag}
                </span>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {!isExternal && <div class="lg:hidden"><PostToc lang={lang} /></div>}

    {
      !isExternal && (
        <div
          class="mt-10 space-y-4 leading-relaxed text-slate-700 dark:text-slate-300 [&_a]:text-emerald-700 [&_a]:underline dark:[&_a]:text-emerald-400"
          lang={isFallback ? 'en' : undefined}
          dir={isFallback ? 'ltr' : undefined}
        >
          <Content />
        </div>
      )
    }

    {
      isExternal && post.data.mediumUrl && (
        <div class="mt-10 rounded-xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900/50">
          <p
            class="text-slate-700 dark:text-slate-300"
            set:html={externalHtml}
          />
        </div>
      )
    }

    {
      !isExternal && (
        <aside class="mt-14 flex flex-col gap-4 rounded-xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900/50 sm:flex-row sm:items-center">
          <img
            src={site.image}
            alt={meta.name}
            width={64}
            height={64}
            loading="lazy"
            decoding="async"
            class="h-16 w-16 shrink-0 rounded-full object-cover"
          />
          <div>
            <p class="font-medium text-slate-900 dark:text-slate-100">
              {meta.name}
            </p>
            <p class="mt-1 text-sm leading-relaxed text-slate-600 dark:text-slate-400">
              {t.post.authorBio}
            </p>
            <p class="mt-2 text-sm">
              <a
                href={site.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-emerald-700 hover:underline dark:text-emerald-400"
              >
                {t.post.authorLinkedin}
              </a>
              <span class="mx-2 text-slate-400">·</span>
              <a
                href={localizePath('/contact', lang)}
                class="font-medium text-emerald-700 hover:underline dark:text-emerald-400"
              >
                {t.post.authorContact}
              </a>
            </p>
          </div>
        </aside>
      )
    }

    {
      seriesPosition && (
        <SeriesNav
          position={seriesPosition}
          lang={lang}
          seriesTitle={t.series.title}
        />
      )
    }

    <p class="mt-12">
      <a
        href={localizePath('/blog', lang)}
        class="text-sm font-medium text-emerald-700 hover:underline dark:text-emerald-400"
      >
        {t.post.back}
      </a>
    </p>
    </div>

    {!isExternal && (
      <aside class="hidden lg:block lg:sticky lg:top-32 lg:order-last">
        <PostToc lang={lang} />
      </aside>
    )}
  </article>
</BaseLayout>
