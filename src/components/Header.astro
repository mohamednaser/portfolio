---
import LanguageSwitch from './LanguageSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { localizePath, stripLang, type Lang } from '../i18n';
import { useTranslations } from '../i18n/ui';
import { navByLang, siteMeta } from '../site.config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = navByLang[lang].map((item) => ({
  href: localizePath(item.href, lang),
  label: t.nav[item.labelKey],
  root: item.href === '/',
}));

/** Compare against the locale-stripped path so `/ar/about` matches `/about`. */
const current = stripLang(Astro.url.pathname).replace(/\/$/, '') || '/';

function isActive(href: string, root: boolean): boolean {
  const target = stripLang(href).replace(/\/$/, '') || '/';
  return root ? current === '/' : current.startsWith(target);
}
---

<header
  class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur dark:border-slate-800/80 dark:bg-slate-950/90"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-6 py-4">
    <a
      href={localizePath('/', lang)}
      class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-50"
    >
      {siteMeta[lang].name}
    </a>
    <nav class="hidden items-center gap-1 md:flex" aria-label={t.common.mainNav}>
      {
        items.map((item) => {
          const active = isActive(item.href, item.root);
          return (
            <a
              href={item.href}
              class:list={[
                'rounded-lg px-3 py-2 text-sm font-medium transition',
                active
                  ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-400'
                  : 'text-slate-600 hover:text-emerald-700 dark:text-slate-300 dark:hover:text-emerald-400',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
    <div class="flex items-center gap-2">
      <button
        type="button"
        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg text-slate-500 hover:text-emerald-700 hover:bg-emerald-50 transition dark:text-slate-400 dark:hover:text-emerald-400 dark:hover:bg-emerald-950/50"
        aria-label={t.common.search}
        onclick="document.dispatchEvent(new CustomEvent('open-search'))"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>
      <LanguageSwitch lang={lang} />
      <ThemeToggle lang={lang} />
      <button
        type="button"
        id="mobile-menu-btn"
        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-lg border border-slate-300 p-2 md:hidden dark:border-slate-600"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.common.openMenu}
        data-label-open={t.common.openMenu}
        data-label-close={t.common.closeMenu}
      >
        <span aria-hidden="true">☰</span>
      </button>
    </div>
  </div>
  <nav
    id="mobile-menu"
    class="hidden border-t border-slate-200 px-6 py-4 md:hidden dark:border-slate-800"
    aria-label={t.common.mobileNav}
  >
    <ul class="flex flex-col gap-2">
      {
        items.map((item) => {
          const active = isActive(item.href, item.root);
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block rounded-lg px-3 py-2 text-sm font-medium',
                  active
                    ? 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-400'
                    : 'text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800',
                ]}
                aria-current={active ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  /*
   * Every navigation is a full document load, so this module re-runs and binds
   * afresh each time. The `menuBound` guard stays: it costs nothing and keeps
   * the binding idempotent if this is ever called twice.
   */
  function bindMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu || btn.dataset.menuBound === 'true') return;
    btn.dataset.menuBound = 'true';

    function setOpen(open: boolean) {
      menu!.classList.toggle('hidden', !open);
      btn!.setAttribute('aria-expanded', String(open));
      const label = open ? btn!.dataset.labelClose : btn!.dataset.labelOpen;
      if (label) btn!.setAttribute('aria-label', label);
    }

    btn.addEventListener('click', () => {
      setOpen(menu.classList.contains('hidden'));
    });

    // Escape closes the menu and returns focus to the control that opened it.
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      setOpen(false);
      btn.focus();
    });
  }

  bindMobileMenu();
</script>
