---
import { contentSlug } from '../lib/slug';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
  /** Article titles and teasers are English — force LTR inside an RTL page. */
  isolateLtr?: boolean;
}

const { post, isolateLtr = false } = Astro.props;
const slug = contentSlug(post.id);
const href = `/blog/${slug}`;
const teaser = post.data.excerpt ?? post.data.description;
const hasCover = Boolean(post.data.coverImage);
---

<article
  class="group border-b border-slate-200 py-10 last:border-b-0 dark:border-slate-800"
  lang={isolateLtr ? 'en' : undefined}
  dir={isolateLtr ? 'ltr' : undefined}
>
  <div
    class:list={[
      'flex flex-col gap-6',
      hasCover && 'sm:flex-row sm:items-start sm:justify-between',
    ]}
  >
    <div class:list={['min-w-0 flex-1', hasCover && 'sm:max-w-[62%]']}>
      <time
        datetime={post.data.pubDate.toISOString()}
        class="text-sm text-slate-500 dark:text-slate-400"
      >
        {
          post.data.pubDate.toLocaleDateString('en-GB', {
            year: 'numeric',
            month: 'short',
            day: 'numeric',
          })
        }
        {
          post.data.readingTime && (
            <span class="before:mx-2 before:content-['·']">{post.data.readingTime}</span>
          )
        }
      </time>
      <h2 class="mt-2 text-xl font-bold leading-snug text-slate-900 dark:text-slate-50 sm:text-2xl">
        <a
          href={href}
          class="transition-colors group-hover:text-emerald-600 dark:group-hover:text-emerald-400"
        >
          {post.data.title}
        </a>
      </h2>
      <p class="mt-3 line-clamp-3 text-base leading-relaxed text-slate-600 dark:text-slate-400">
        {teaser}
      </p>
      {
        post.data.keywords.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Topics">
            {post.data.keywords.slice(0, 5).map((keyword) => (
              <li>
                <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-600 dark:bg-slate-800 dark:text-slate-400">
                  {keyword}
                </span>
              </li>
            ))}
          </ul>
        )
      }
      <div class="mt-5 flex flex-wrap items-center gap-3 text-sm">
        <a href={href} class="font-medium text-emerald-600 hover:underline dark:text-emerald-400">
          {post.data.external ? 'View summary' : 'Read article'}
        </a>
        {
          post.data.mediumUrl && (
            <a
              href={post.data.mediumUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-slate-600 underline decoration-slate-300 underline-offset-2 hover:text-slate-900 dark:text-slate-400 dark:decoration-slate-600 dark:hover:text-slate-200"
            >
              Medium ↗
            </a>
          )
        }
        {
          post.data.linkedinUrl && (
            <a
              href={post.data.linkedinUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="font-medium text-slate-600 underline decoration-slate-300 underline-offset-2 hover:text-slate-900 dark:text-slate-400 dark:decoration-slate-600 dark:hover:text-slate-200"
            >
              LinkedIn profile ↗
            </a>
          )
        }
      </div>
    </div>
    {
      hasCover && (
        <a
          href={href}
          class="block shrink-0 overflow-hidden rounded-lg sm:w-[220px] md:w-[260px]"
          aria-hidden="true"
          tabindex="-1"
        >
          <img
            src={post.data.coverImage}
            alt=""
            width={260}
            height={137}
            class="aspect-[1200/630] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
            loading="lazy"
          />
        </a>
      )
    }
  </div>
</article>
