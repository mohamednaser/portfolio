---
import CompaniesMarquee from './CompaniesMarquee.astro';
import { companyLogos } from '../data/companies';
import { defaultLang, type Lang } from '../i18n';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang?: Lang;
  heading?: string;
}

const { lang = defaultLang, heading } = Astro.props;
const t = useTranslations(lang);
const resolvedHeading = heading ?? t.companies.heading;
---

<section
  class="border-y border-slate-200 bg-slate-50 py-16 dark:border-slate-800 dark:bg-slate-900/40"
  aria-labelledby="companies-heading"
>
  <div class="mx-auto max-w-5xl px-6">
    <h2 id="companies-heading" class="section-heading text-center">
      {resolvedHeading}
    </h2>
    <CompaniesMarquee items={companyLogos} lang={lang} />
  </div>
</section>
