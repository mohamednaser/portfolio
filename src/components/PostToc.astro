---
import { type Lang } from '../i18n';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

{/*
  Built client-side: these article bodies are imported `.astro` components, so
  their headings never reach the MDX AST and `render()` returns no `headings`.
  Stays `hidden` until the script finds at least two — a one-item contents list
  is worse than none.
*/}
<nav class="post-toc mt-10" aria-labelledby="post-toc-label" hidden>
  <details class="post-toc-details rounded-xl border border-slate-200 dark:border-slate-800">
    <summary
      class="post-toc-label cursor-pointer list-none px-5 py-3 text-sm font-semibold text-slate-900 marker:content-none dark:text-slate-100"
    >
      {t.post.onThisPage}
    </summary>
    <ol class="post-toc-list space-y-2 px-5 pb-4 text-sm"></ol>
  </details>
</nav>

<style>
  /* The disclosure triangle is replaced by the +/− affordance below. */
  .post-toc summary::-webkit-details-marker {
    display: none;
  }

  .post-toc summary::after {
    content: '+';
    float: inline-end;
    font-weight: 400;
  }

  .post-toc details[open] > summary::after {
    content: '−';
  }
</style>

<script>
  const HEADING_SELECTOR = 'article h2';

  /**
   * Latin headings get a readable anchor. Anything else falls back to an index:
   * an Arabic heading like "الحالة 01 · …" would otherwise reduce to "01", which
   * is not a valid CSS identifier.
   */
  function slugify(text: string, index: number): string {
    const slug = text
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '');
    return /^[a-z]/.test(slug) ? slug : `section-${index + 1}`;
  }

  function buildToc() {
    const navs = document.querySelectorAll<HTMLElement>('.post-toc');
    if (navs.length === 0) return;

    const headings = [...document.querySelectorAll<HTMLHeadingElement>(HEADING_SELECTOR)];
    
    // One entry is not a table of contents; leave the blocks hidden.
    if (headings.length < 2) {
      navs.forEach(nav => nav.hidden = true);
      return;
    }

    const used = new Set<string>();
    headings.forEach((heading, index) => {
      const text = heading.textContent?.trim() ?? '';
      if (!heading.id) {
        let id = slugify(text, index);
        while (used.has(id)) id = `${id}-${index}`;
        heading.id = id;
      }
      used.add(heading.id);
    });

    navs.forEach(nav => {
      const list = nav.querySelector<HTMLElement>('.post-toc-list');
      const details = nav.querySelector<HTMLDetailsElement>('.post-toc-details');
      if (!list || !details) return;

      list.replaceChildren();

      headings.forEach((heading) => {
        const text = heading.textContent?.trim() ?? '';
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = text;
        link.className =
          'block border-l-2 border-transparent py-1 pl-3 text-slate-600 transition-colors hover:border-emerald-500 hover:text-emerald-700 dark:text-slate-400 dark:hover:text-emerald-400 aria-[current=true]:border-emerald-500 aria-[current=true]:font-medium aria-[current=true]:text-emerald-700 dark:aria-[current=true]:border-emerald-400 dark:aria-[current=true]:text-emerald-400';

        const item = document.createElement('li');
        item.appendChild(link);
        list.appendChild(item);
      });

      nav.hidden = false;
      // Open where vertical space is cheap; collapsed on phones.
      details.open = window.matchMedia('(min-width: 1024px)').matches;

      trackActiveHeading(headings, list);
    });
  }

  /** Marks the heading currently at the top of the viewport. */
  function trackActiveHeading(headings: HTMLHeadingElement[], list: HTMLElement) {
    const links = [...list.querySelectorAll('a')];

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = entry.target.id;
          links.forEach((link) => {
            link.setAttribute(
              'aria-current',
              link.getAttribute('href') === `#${id}` ? 'true' : 'false',
            );
          });
        }
      },
      { rootMargin: '-80px 0px -70% 0px' },
    );

    headings.forEach((heading) => observer.observe(heading));
  }

  document.addEventListener('astro:page-load', buildToc);
</script>
