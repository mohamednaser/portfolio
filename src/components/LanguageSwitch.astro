---
import { alternatePath, defaultLang, languages, type Lang } from '../i18n';
import { useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const target: Lang = lang === defaultLang ? 'ar' : defaultLang;
const t = useTranslations(lang);
const href = alternatePath(Astro.url.pathname, target);
---

<a
  href={href}
  hreflang={languages[target].htmlLang}
  lang={languages[target].htmlLang}
  dir={languages[target].dir}
  rel="alternate"
  aria-label={t.common.switchLanguage}
  title={t.common.switchLanguage}
  class:list={[
    'inline-flex min-h-[44px] items-center justify-center rounded-lg border border-slate-300 px-3 text-sm font-medium text-slate-600 transition hover:border-emerald-500 hover:text-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-500 dark:border-slate-600 dark:text-slate-300 dark:hover:text-emerald-400',
    className,
  ]}
>
  {languages[target].short}
</a>
