---
---
<div class="phantom-deploy-widget" aria-label="Phantom Deployment Architecture Diagram">
  <div class="widget-header">
    <h3>The Phantom Deployment</h3>
    <p>How an identical <code>:latest</code> tag caused a silent split-brain in production.</p>
  </div>

  <div class="svg-container">
    <svg viewBox="0 0 800 300" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#6b7280" />
        </marker>
        <marker id="arrow-red" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#ef4444" />
        </marker>
        <marker id="arrow-green" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
          <path d="M 0 0 L 10 5 L 0 10 z" fill="#10b981" />
        </marker>
      </defs>

      <!-- Central Deploy command -->
      <rect x="300" y="20" width="200" height="40" rx="6" fill="#374151" />
      <text x="400" y="45" font-family="monospace" font-size="14" fill="#f9fafb" text-anchor="middle">docker compose up -d</text>

      <!-- Web path -->
      <path d="M 350 60 L 250 100" stroke="#6b7280" stroke-width="2" marker-end="url(#arrow)" />
      
      <!-- Worker path -->
      <path d="M 450 60 L 550 100" stroke="#6b7280" stroke-width="2" marker-end="url(#arrow)" />

      <!-- Web Container -->
      <rect x="150" y="100" width="200" height="80" rx="6" fill="#d1fae5" stroke="#059669" stroke-width="2" />
      <text x="250" y="130" font-family="sans-serif" font-weight="bold" font-size="16" fill="#064e3b" text-anchor="middle">Web Container</text>
      <text x="250" y="155" font-family="monospace" font-size="14" fill="#059669" text-anchor="middle">image: app:latest</text>
      <circle cx="165" cy="115" r="5" fill="#10b981" />
      <text x="180" y="119" font-family="sans-serif" font-weight="bold" font-size="12" fill="#064e3b">Restarted: v2.0</text>

      <!-- Worker Container -->
      <rect x="450" y="100" width="200" height="80" rx="6" fill="#fee2e2" stroke="#dc2626" stroke-width="2" />
      <text x="550" y="130" font-family="sans-serif" font-weight="bold" font-size="16" fill="#991b1b" text-anchor="middle">Worker Container</text>
      <text x="550" y="155" font-family="monospace" font-size="14" fill="#dc2626" text-anchor="middle">image: app:latest</text>
      <circle cx="465" cy="115" r="5" fill="#ef4444" />
      <text x="480" y="119" font-family="sans-serif" font-weight="bold" font-size="12" fill="#991b1b">Ignored: Stuck on v1.0</text>

      <!-- Redis Target (Good) -->
      <path d="M 250 180 L 250 230" stroke="#10b981" stroke-width="2" stroke-dasharray="5,5" marker-end="url(#arrow-green)" />
      <rect x="175" y="230" width="150" height="40" rx="4" fill="#f3f4f6" stroke="#9ca3af" stroke-width="1" />
      <text x="250" y="255" font-family="sans-serif" font-weight="bold" font-size="14" fill="#374151" text-anchor="middle">Redis Queue</text>

      <!-- Database Target (Bad) -->
      <path d="M 550 180 L 550 230" stroke="#ef4444" stroke-width="2" stroke-dasharray="5,5" marker-end="url(#arrow-red)" />
      <rect x="475" y="230" width="150" height="40" rx="4" fill="#1f2937" stroke="#000" stroke-width="1" />
      <text x="550" y="255" font-family="sans-serif" font-weight="bold" font-size="14" fill="#f9fafb" text-anchor="middle">MySQL Queue</text>
      <text x="550" y="285" font-family="sans-serif" font-size="12" fill="#ef4444" text-anchor="middle">(The Black Hole)</text>
    </svg>
  </div>
</div>

<style>
  .phantom-deploy-widget {
    background-color: var(--bg-card, #f8f9fa);
    border: 1px solid var(--border-color, #e5e7eb);
    border-radius: 8px;
    padding: 1.5rem;
    margin: 2rem 0;
    font-family: inherit;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  .widget-header h3 { margin: 0 0 0.5rem 0; font-size: 1.25rem; }
  .widget-header p { margin: 0 0 1.5rem 0; color: var(--text-muted, #6b7280); font-size: 0.9rem; }
  
  .svg-container {
    width: 100%;
    overflow-x: auto;
  }

  @media (prefers-color-scheme: dark) {
    .phantom-deploy-widget { background-color: #1f2937; border-color: #374151; }
  }
</style>
