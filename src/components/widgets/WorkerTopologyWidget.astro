---
const node1 = [
  ...Array(10).fill('pdf'),
  ...Array(20).fill('default'),
  ...Array(33).fill('email')
];
const node2 = [
  ...Array(15).fill('default'),
  ...Array(7).fill('email')
];
const node3 = [
  ...Array(15).fill('default'),
  ...Array(22).fill('email')
];
---
<div class="topology-widget" aria-label="Worker Topology Map">
  <div class="widget-header">
    <h3>The Asymmetrical Worker Topology</h3>
    <p>Hover over the queue types to see how the 122 processes ended up unevenly distributed across 3 nodes.</p>
  </div>

  <div class="queues-legend">
    <button class="queue-btn" data-target="pdf"><span class="q-dot pdf"></span> heavy-pdf (10)</button>
    <button class="queue-btn" data-target="default"><span class="q-dot default"></span> default (50)</button>
    <button class="queue-btn" data-target="email"><span class="q-dot email"></span> light-email (62)</button>
  </div>

  <div class="server-rack">
    <!-- Server 1 -->
    <div class="server node1">
      <div class="server-head">
        <h4>Node 01</h4>
        <span class="badge warning">63 Workers</span>
      </div>
      <div class="worker-grid">
        {node1.map(type => (
          <div class={`worker-box ${type}`} title={`${type} worker`} />
        ))}
      </div>
    </div>

    <!-- Server 2 -->
    <div class="server node2">
      <div class="server-head">
        <h4>Node 02</h4>
        <span class="badge success">22 Workers</span>
      </div>
      <div class="worker-grid">
        {node2.map(type => (
          <div class={`worker-box ${type}`} title={`${type} worker`} />
        ))}
      </div>
    </div>

    <!-- Server 3 -->
    <div class="server node3">
      <div class="server-head">
        <h4>Node 03</h4>
        <span class="badge neutral">37 Workers</span>
      </div>
      <div class="worker-grid">
        {node3.map(type => (
          <div class={`worker-box ${type}`} title={`${type} worker`} />
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  .topology-widget {
    background-color: var(--bg-card, #f8f9fa);
    border: 1px solid var(--border-color, #e5e7eb);
    border-radius: 8px;
    padding: 1.5rem;
    margin: 2rem 0;
    font-family: inherit;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  .widget-header h3 { margin: 0 0 0.5rem 0; font-size: 1.25rem; }
  .widget-header p { margin: 0 0 1.5rem 0; color: var(--text-muted, #6b7280); font-size: 0.9rem; }
  
  .queues-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2rem;
    justify-content: center;
  }
  .queue-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: white;
    border: 1px solid var(--border-color, #e5e7eb);
    padding: 0.5rem 1rem;
    border-radius: 99px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  .queue-btn:hover { background: #f3f4f6; transform: translateY(-2px); }
  
  .q-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .q-dot.pdf, .worker-box.pdf { background-color: #ef4444; }
  .q-dot.default, .worker-box.default { background-color: #3b82f6; }
  .q-dot.email, .worker-box.email { background-color: #10b981; }

  .server-rack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .server {
    background: white;
    border: 1px solid var(--border-color, #e5e7eb);
    border-radius: 6px;
    padding: 1rem;
  }
  .server-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-color, #e5e7eb);
  }
  .server-head h4 { margin: 0; font-size: 1rem; color: #374151; font-family: monospace; }
  
  .badge { font-size: 0.75rem; padding: 0.25rem 0.5rem; border-radius: 4px; font-weight: 600; }
  .badge.warning { background: #fee2e2; color: #991b1b; }
  .badge.success { background: #d1fae5; color: #065f46; }
  .badge.neutral { background: #f3f4f6; color: #374151; }

  .worker-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .worker-box {
    width: 14px;
    height: 14px;
    border-radius: 2px;
    opacity: 0.8;
    transition: all 0.3s;
  }

  /* Interaction states */
  .topology-widget.focus-pdf .worker-box:not(.pdf) { opacity: 0.1; transform: scale(0.8); }
  .topology-widget.focus-default .worker-box:not(.default) { opacity: 0.1; transform: scale(0.8); }
  .topology-widget.focus-email .worker-box:not(.email) { opacity: 0.1; transform: scale(0.8); }

  @media (prefers-color-scheme: dark) {
    .topology-widget { background-color: #1f2937; border-color: #374151; }
    .server { background: #111827; border-color: #374151; }
    .server-head { border-color: #374151; }
    .server-head h4 { color: #d1d5db; }
    .queue-btn { background: #111827; border-color: #374151; color: #e5e7eb; }
    .queue-btn:hover { background: #374151; }
    .badge.warning { background: #450a0a; color: #fca5a5; }
    .badge.success { background: #064e3b; color: #6ee7b7; }
    .badge.neutral { background: #374151; color: #d1d5db; }
  }
</style>

<script>
  function initTopology() {
    const widget = document.querySelector('.topology-widget');
    if (!widget) return;

    const btns = widget.querySelectorAll('.queue-btn');
    
    btns.forEach(btn => {
      btn.addEventListener('mouseenter', () => {
        const target = btn.getAttribute('data-target');
        widget.classList.add(`focus-${target}`);
      });
      
      btn.addEventListener('mouseleave', () => {
        const target = btn.getAttribute('data-target');
        widget.classList.remove(`focus-${target}`);
      });
    });
  }

  document.addEventListener('astro:page-load', initTopology);
  document.addEventListener('DOMContentLoaded', initTopology);
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    initTopology();
  }
</script>
