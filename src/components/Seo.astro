---
import { sameAsUrls } from '../data/social';
import {
  alternatePath,
  defaultLang,
  isUntranslatedPath,
  langCodes,
  languages,
  localizePath,
  type Lang,
} from '../i18n';
import { useTranslations } from '../i18n/ui';
import { site, siteMeta } from '../site.config';

interface Props {
  lang?: Lang;
  /** Document `<title>` and default OG title (may include site suffix). */
  title?: string;
  /** Raw headline for JSON-LD / OG when different from `title` (e.g. blog posts). */
  seoTitle?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  keywords?: string[];
  canonicalUrl?: string;
  /** Original publication URL (e.g. Medium) — `rel="alternate"`, not canonical. */
  alternateUrl?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  lang = defaultLang,
  title,
  seoTitle,
  description,
  image = site.image,
  type = 'website',
  noindex = false,
  keywords = [],
  canonicalUrl,
  alternateUrl,
  publishedTime,
  modifiedTime,
} = Astro.props;

const meta = siteMeta[lang];
const t = useTranslations(lang);
const feedHref = new URL(localizePath('/rss.xml', lang), site.url).href;
const resolvedTitle = title ?? meta.title;
const resolvedDescription = description ?? meta.description;

const canonical = canonicalUrl ?? new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;
const keywordsContent = keywords.length > 0 ? keywords.join(', ') : undefined;
const headline = seoTitle ?? resolvedTitle;
const siteImage = new URL(site.image, site.url).href;

/** Article pages have no Arabic twin — do not advertise one. */
const localeAlternates = isUntranslatedPath(Astro.url.pathname)
  ? []
  : langCodes.map((code) => ({
      hreflang: languages[code].htmlLang,
      href: new URL(alternatePath(Astro.url.pathname, code), site.url).href,
    }));

// No `email` here on purpose: JSON-LD is emitted on every page, so a plain address in it
// is machine-readable bait for scrapers. The contact page still offers a mailto link.
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: meta.name,
  alternateName: lang === defaultLang ? siteMeta.ar.name : site.name,
  url: site.url,
  image: siteImage,
  sameAs: sameAsUrls,
  jobTitle: meta.jobTitle,
  description: meta.description,
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: meta.name,
  url: site.url,
  inLanguage: languages[lang].htmlLang,
  description: meta.description,
};

/**
 * `datePublished` is required for Article types; without it Google reports a
 * missing-field error rather than ignoring the block. Pages that cannot supply
 * one simply do not describe themselves as articles.
 */
const articleSchema =
  type === 'article' && publishedTime
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline,
        description: resolvedDescription,
        image: ogImage,
        inLanguage: languages[lang].htmlLang,
        datePublished: publishedTime,
        dateModified: modifiedTime ?? publishedTime,
        author: { '@type': 'Person', name: meta.name, url: site.url },
        publisher: { '@type': 'Person', name: meta.name },
        keywords: keywordsContent,
        mainEntityOfPage: canonical,
        url: canonical,
      }
    : null;
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={resolvedDescription} />
{keywordsContent && <meta name="keywords" content={keywordsContent} />}
<link rel="canonical" href={canonical} />
{localeAlternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
{
  localeAlternates.length > 0 && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternatePath(Astro.url.pathname, defaultLang), site.url).href}
    />
  )
}
{alternateUrl && <link rel="alternate" href={alternateUrl} />}
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${meta.name} — ${t.blog.title}`}
  href={feedHref}
/>

<meta property="og:type" content={type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={headline} />
<meta property="og:description" content={resolvedDescription} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={meta.name} />
<meta property="og:locale" content={languages[lang].ogLocale} />
{
  langCodes
    .filter((code) => code !== lang && localeAlternates.length > 0)
    .map((code) => <meta property="og:locale:alternate" content={languages[code].ogLocale} />)
}
{
  type === 'article' && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )
}
{
  type === 'article' && (modifiedTime ?? publishedTime) && (
    <meta property="article:modified_time" content={modifiedTime ?? publishedTime} />
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={headline} />
<meta name="twitter:description" content={resolvedDescription} />
<meta name="twitter:image" content={ogImage} />

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
