---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import { defaultLang, getLangFromUrl, languages, type Lang } from '../i18n';
import { useTranslations } from '../i18n/ui';
import { siteMeta } from '../site.config';
import { ClientRouter } from 'astro:transitions';
interface Props {
  /** Defaults to the locale implied by the URL; pass explicitly on 404. */
  lang?: Lang;
  title?: string;
  /** Raw headline for OG / JSON-LD (omit to use `title` before suffix). */
  seoTitle?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  keywords?: string[];
  canonicalUrl?: string;
  alternateUrl?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  lang = getLangFromUrl(Astro.url),
  title,
  seoTitle,
  description,
  image,
  type,
  noindex,
  keywords,
  canonicalUrl,
  alternateUrl,
  publishedTime,
  modifiedTime,
} = Astro.props;

const meta = siteMeta[lang];
const t = useTranslations(lang);
const { htmlLang, dir } = languages[lang];

const pageTitle = title ? `${title} · ${meta.name}` : meta.title;
---

<!doctype html>
<html lang={htmlLang} dir={dir}>
  <head>
    <ClientRouter />
    <Seo
      lang={lang}
      title={pageTitle}
      seoTitle={seoTitle ?? (title ? title : undefined)}
      description={description ?? meta.description}
      image={image}
      type={type}
      noindex={noindex}
      keywords={keywords}
      canonicalUrl={canonicalUrl}
      alternateUrl={alternateUrl}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    <title>{pageTitle}</title>
    {
      lang !== defaultLang && (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href="/fonts/ibm-plex-sans-arabic-arabic-400.woff2"
          crossorigin
        />
      )
    }
    <script is:inline>
      (function () {
        const storageKey = 'mnaser-theme';

        function applyTheme(isDark) {
          document.documentElement.classList.toggle('dark', isDark);
          document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
          document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
        }

        function readStoredTheme() {
          const stored = localStorage.getItem(storageKey);
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          return stored === 'dark' || (stored !== 'light' && prefersDark);
        }

        applyTheme(readStoredTheme());

        function bindToggle() {
          const btn = document.getElementById('theme-toggle');
          if (!btn || btn.dataset.themeBound === 'true') return;
          btn.dataset.themeBound = 'true';
          btn.addEventListener('click', () => {
            const isDark = !document.documentElement.classList.contains('dark');
            applyTheme(isDark);
            localStorage.setItem(storageKey, isDark ? 'dark' : 'light');
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bindToggle, {
            once: true,
          });
        } else {
          bindToggle();
        }

        document.addEventListener('astro:page-load', bindToggle);
      })();
    </script>
    <Analytics />
  </head>
  <body
    class="min-h-screen bg-white text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-100"
  >
    <div
      id="reading-progress"
      class="fixed left-0 top-0 z-[100] h-1 w-0 bg-emerald-500 transition-all duration-150 ease-out"
      aria-hidden="true"
    ></div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-emerald-600 focus:px-4 focus:py-2 focus:text-white"
    >
      {t.common.skipToContent}
    </a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import mediumZoom from 'medium-zoom';

      function initZoom() {
        // Select all images in the main content area
        // Customize the selector if needed (e.g., '.lynk-post img')
        const images = document.querySelectorAll('main img');
        mediumZoom(images, {
          margin: 24,
          background: 'rgba(0, 0, 0, 0.8)',
        });
      }

      // Initialize on load
      initZoom();

      // Re-initialize after Astro view transitions
      document.addEventListener('astro:page-load', initZoom);

      function initScrollAnimations() {
        const observer = new IntersectionObserver(
          (entries) => {
            let delayCount = 0;
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                // Add staggered delay based on order of appearance in viewport
                (entry.target as HTMLElement).style.transitionDelay = `${delayCount * 100}ms`;
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
                delayCount++;
                
                // Reset transition delay after animation completes so it doesn't affect other states
                setTimeout(() => {
                  (entry.target as HTMLElement).style.transitionDelay = '0ms';
                }, 1000);
              }
            });
          },
          { rootMargin: '0px 0px -50px 0px', threshold: 0.1 }
        );

        document.querySelectorAll('.fade-up').forEach((el) => {
          observer.observe(el);
        });
      }

      // Initialize on load and after transitions
      initScrollAnimations();
      document.addEventListener('astro:page-load', initScrollAnimations);

      // --- 1. Reading Progress Bar ---
      function updateReadingProgress() {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        const progressBar = document.getElementById('reading-progress');
        if (progressBar) {
          progressBar.style.width = scrolled + '%';
        }
      }
      window.addEventListener('scroll', updateReadingProgress);

      // --- 4. Interactive Copy Buttons on Code Blocks ---
      function initCopyButtons() {
        const blocks = document.querySelectorAll('pre');
        blocks.forEach((block) => {
          // Prevent adding multiple buttons if initialized multiple times
          if (block.parentNode && (block.parentNode as Element).classList.contains('code-block-wrapper')) return;

          const wrapper = document.createElement('div');
          wrapper.className = 'code-block-wrapper group relative';
          
          if (block.parentNode) {
            block.parentNode.insertBefore(wrapper, block);
          }
          wrapper.appendChild(block);

          const button = document.createElement('button');
          button.className =
            'copy-btn absolute right-2 top-2 rounded-md border border-slate-700 bg-slate-800 p-1.5 text-slate-400 opacity-0 transition-all group-hover:opacity-100 hover:bg-slate-700 hover:text-white dark:border-slate-600 dark:bg-slate-900';
          button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>';
          
          button.addEventListener('click', async () => {
            const code = block.querySelector('code');
            if (!code) return;
            try {
              await navigator.clipboard.writeText(code.innerText);
              button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>';
              setTimeout(() => {
                button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>';
              }, 2000);
            } catch (err) {
              console.error('Failed to copy text: ', err);
            }
          });
          wrapper.appendChild(button);
        });
      }

      initCopyButtons();
      document.addEventListener('astro:page-load', initCopyButtons);
    </script>
  </body>
</html>
