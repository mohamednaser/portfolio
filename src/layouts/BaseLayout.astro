---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import { defaultLang, getLangFromUrl, languages, type Lang } from '../i18n';
import { useTranslations } from '../i18n/ui';
import { siteMeta } from '../site.config';

interface Props {
  /** Defaults to the locale implied by the URL; pass explicitly on 404. */
  lang?: Lang;
  title?: string;
  /** Raw headline for OG / JSON-LD (omit to use `title` before suffix). */
  seoTitle?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  keywords?: string[];
  canonicalUrl?: string;
  alternateUrl?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  lang = getLangFromUrl(Astro.url),
  title,
  seoTitle,
  description,
  image,
  type,
  noindex,
  keywords,
  canonicalUrl,
  alternateUrl,
  publishedTime,
  modifiedTime,
} = Astro.props;

const meta = siteMeta[lang];
const t = useTranslations(lang);
const { htmlLang, dir } = languages[lang];

const pageTitle = title ? `${title} · ${meta.name}` : meta.title;
---

<!doctype html>
<html lang={htmlLang} dir={dir}>
  <head>
    <Seo
      lang={lang}
      title={pageTitle}
      seoTitle={seoTitle ?? (title ? title : undefined)}
      description={description ?? meta.description}
      image={image}
      type={type}
      noindex={noindex}
      keywords={keywords}
      canonicalUrl={canonicalUrl}
      alternateUrl={alternateUrl}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    <title>{pageTitle}</title>
    {
      lang !== defaultLang && (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href="/fonts/ibm-plex-sans-arabic-arabic-400.woff2"
          crossorigin
        />
      )
    }
    <script is:inline>
      (function () {
        const storageKey = 'mnaser-theme';

        function applyTheme(isDark) {
          document.documentElement.classList.toggle('dark', isDark);
          document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
          document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
        }

        function readStoredTheme() {
          const stored = localStorage.getItem(storageKey);
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          return stored === 'dark' || (stored !== 'light' && prefersDark);
        }

        applyTheme(readStoredTheme());

        function bindToggle() {
          const btn = document.getElementById('theme-toggle');
          if (!btn || btn.dataset.themeBound === 'true') return;
          btn.dataset.themeBound = 'true';
          btn.addEventListener('click', () => {
            const isDark = !document.documentElement.classList.contains('dark');
            applyTheme(isDark);
            localStorage.setItem(storageKey, isDark ? 'dark' : 'light');
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bindToggle, {
            once: true,
          });
        } else {
          bindToggle();
        }

        document.addEventListener('astro:page-load', bindToggle);
      })();
    </script>
    <Analytics />
  </head>
  <body
    class="min-h-screen bg-white text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-100"
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-emerald-600 focus:px-4 focus:py-2 focus:text-white"
    >
      {t.common.skipToContent}
    </a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
