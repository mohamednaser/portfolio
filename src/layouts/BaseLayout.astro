---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Seo from '../components/Seo.astro';
import { defaultLang, getLangFromUrl, languages, type Lang } from '../i18n';
import { useTranslations } from '../i18n/ui';
import { siteMeta } from '../site.config';
import { ClientRouter } from 'astro:transitions';
interface Props {
  /** Defaults to the locale implied by the URL; pass explicitly on 404. */
  lang?: Lang;
  title?: string;
  /** Raw headline for OG / JSON-LD (omit to use `title` before suffix). */
  seoTitle?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  keywords?: string[];
  canonicalUrl?: string;
  alternateUrl?: string;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  lang = getLangFromUrl(Astro.url),
  title,
  seoTitle,
  description,
  image,
  type,
  noindex,
  keywords,
  canonicalUrl,
  alternateUrl,
  publishedTime,
  modifiedTime,
} = Astro.props;

const meta = siteMeta[lang];
const t = useTranslations(lang);
const { htmlLang, dir } = languages[lang];

const pageTitle = title ? `${title} · ${meta.name}` : meta.title;
---

<!doctype html>
<html lang={htmlLang} dir={dir}>
  <head>
    <ClientRouter />
    <Seo
      lang={lang}
      title={pageTitle}
      seoTitle={seoTitle ?? (title ? title : undefined)}
      description={description ?? meta.description}
      image={image}
      type={type}
      noindex={noindex}
      keywords={keywords}
      canonicalUrl={canonicalUrl}
      alternateUrl={alternateUrl}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    <title>{pageTitle}</title>
    {
      lang !== defaultLang && (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href="/fonts/ibm-plex-sans-arabic-arabic-400.woff2"
          crossorigin
        />
      )
    }
    <script is:inline>
      (function () {
        // Paired with `html.js .fade-up` in global.css: scroll-reveal only hides
        // content once we know a script is running to reveal it again.
        document.documentElement.classList.add('js');

        const storageKey = 'mnaser-theme';

        function applyTheme(isDark) {
          document.documentElement.classList.toggle('dark', isDark);
          document.documentElement.dataset.theme = isDark ? 'dark' : 'light';
          document.documentElement.style.colorScheme = isDark ? 'dark' : 'light';
        }

        function readStoredTheme() {
          const stored = localStorage.getItem(storageKey);
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          return stored === 'dark' || (stored !== 'light' && prefersDark);
        }

        applyTheme(readStoredTheme());

        function bindToggle() {
          const btn = document.getElementById('theme-toggle');
          if (!btn || btn.dataset.themeBound === 'true') return;
          btn.dataset.themeBound = 'true';
          btn.addEventListener('click', () => {
            const isDark = !document.documentElement.classList.contains('dark');
            applyTheme(isDark);
            localStorage.setItem(storageKey, isDark ? 'dark' : 'light');
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', bindToggle, {
            once: true,
          });
        } else {
          bindToggle();
        }

        document.addEventListener('astro:page-load', bindToggle);
      })();
    </script>
    <Analytics />
  </head>
  <body
    class="min-h-screen bg-white text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-100"
  >
    <div
      id="reading-progress"
      class="fixed left-0 top-0 z-[100] h-1 w-0 bg-emerald-500 transition-all duration-150 ease-out"
      aria-hidden="true"
    ></div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-emerald-700 focus:px-4 focus:py-2 focus:text-white"
    >
      {t.common.skipToContent}
    </a>
    <Header lang={lang} />
    <main id="main" data-copy-label={t.common.copyCode} data-copied-label={t.common.copied}>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import mediumZoom from 'medium-zoom';
      import type { Zoom } from 'medium-zoom';

      const COPY_ICON =
        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>';
      const DONE_ICON =
        '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>';

      /** Detached before each re-init: a new instance per navigation leaks handlers. */
      let zoom: Zoom | null = null;

      function initZoom() {
        zoom?.detach();
        zoom = mediumZoom(document.querySelectorAll('main img'), {
          margin: 24,
          background: 'rgba(0, 0, 0, 0.8)',
        });
      }

      function initScrollAnimations() {
        const targets = document.querySelectorAll('.fade-up:not(.is-visible)');
        if (!targets.length) return;

        // Reduced-motion users get the content outright; the CSS drops the
        // transition, so observing would only add work for no visible effect.
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          targets.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            let shown = 0;
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              // Stagger only within a batch; the delay is cleared on transitionend
              // so it never leaks into a later hover or theme transition.
              el.style.transitionDelay = `${shown * 100}ms`;
              el.addEventListener(
                'transitionend',
                () => {
                  el.style.transitionDelay = '';
                },
                { once: true },
              );
              el.classList.add('is-visible');
              observer.unobserve(el);
              shown++;
            });
          },
          { rootMargin: '0px 0px -50px 0px', threshold: 0.1 },
        );

        targets.forEach((el) => observer.observe(el));
      }

      function updateReadingProgress() {
        const bar = document.getElementById('reading-progress');
        if (!bar) return;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = height > 0 ? (window.scrollY / height) * 100 : 0;
        bar.style.width = `${scrolled}%`;
      }

      function initCopyButtons() {
        const main = document.getElementById('main');
        const copyLabel = main?.dataset.copyLabel ?? 'Copy code';
        const copiedLabel = main?.dataset.copiedLabel ?? 'Copied';

        document.querySelectorAll('main pre').forEach((block) => {
          const parent = block.parentElement;
          if (parent?.classList.contains('code-block-wrapper')) return;

          const wrapper = document.createElement('div');
          wrapper.className = 'code-block-wrapper group relative';
          parent?.insertBefore(wrapper, block);
          wrapper.appendChild(block);

          const button = document.createElement('button');
          button.type = 'button';
          button.className =
            'copy-btn absolute end-2 top-2 rounded-md border border-slate-700 bg-slate-800 p-1.5 text-slate-400 opacity-0 transition-all focus-visible:opacity-100 group-hover:opacity-100 hover:bg-slate-700 hover:text-white dark:border-slate-600 dark:bg-slate-900';
          button.setAttribute('aria-label', copyLabel);
          button.title = copyLabel;
          button.innerHTML = COPY_ICON;

          button.addEventListener('click', async () => {
            const code = block.querySelector('code') ?? block;
            try {
              await navigator.clipboard.writeText((code as HTMLElement).innerText);
            } catch {
              return;
            }
            button.innerHTML = DONE_ICON;
            button.setAttribute('aria-label', copiedLabel);
            button.title = copiedLabel;
            setTimeout(() => {
              button.innerHTML = COPY_ICON;
              button.setAttribute('aria-label', copyLabel);
              button.title = copyLabel;
            }, 2000);
          });

          wrapper.appendChild(button);
        });
      }

      window.addEventListener('scroll', updateReadingProgress, { passive: true });

      // `astro:page-load` fires on the first load as well as after every view
      // transition, so calling the initializers here alone avoids double-init.
      document.addEventListener('astro:page-load', () => {
        initZoom();
        initScrollAnimations();
        initCopyButtons();
        updateReadingProgress();
      });
    </script>
  </body>
</html>
